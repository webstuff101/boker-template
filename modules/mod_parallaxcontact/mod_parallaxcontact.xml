<?xml version="1.0" encoding="utf-8"?><extension version="3.1" type="module" client="site" method="upgrade">	<name>Parallax Contact | Globbersthemes </name> 	<author>globbers</author> 	<creationDate> mars 2015</creationDate> 	<copyright>globbersthemes.com.com</copyright> 	<authorEmail>globbers@hotmail.fr</authorEmail> 	<authorUrl>www.globbersthemes.com.com</authorUrl> 	<version>3.0.0</version> 	<description>	 <![CDATA[<h1> contact Module Joomla </h1>	    			<br /><br />]]>			</description>	<files>	   <filename>mod_parallaxcontact.xml</filename> 		<filename module="mod_parallaxcontact">mod_parallaxcontact.php</filename>		<filename>helper.php</filename>		<filename>index.html</filename>		<folder>assets</folder>		<folder>tmpl</folder>	</files>	<config>		<fields name="params">			<fieldset name="basic">                <field name="recipient" type="email" default="" label="Your Email" description="Enter Your Email" required="true" validate="email" />				<field name="pretext" type="text" default="" label="Pretext" description="" />				<field name="name" type="text" default="Name" label="Name" description="" />				<field name="email" type="text" default="Email" label="Email" description="" />				<field name="message" type="text" default="Message" label="Message" description="" />				<field name="captcha_label" type="text" default="Captcha" label="Captcha" description="" />				<field name="submit" type="text" default="Send" label="Send" description="" />				<field type="spacer" name="&lt;div class=&quot;sub-heading&quot;&gt;Email&lt;/div&gt;" />				<field name="subject" type="text" default="Request a Quote" label="Request Aquote" description="" />			</fieldset>				</fields>	</config></extension>